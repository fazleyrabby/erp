#<IfModule mod_rewrite.c>
<IfModule mod_rewrite.c>
   RewriteEngine on
    Options +FollowSymlinks
    #redirect http non-www to https://www
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} ^(www\.)?jtsc.abctraders\.com$
    RewriteRule (.*) https://jtsc.abctraders.com/$1 [R=301,L]
    #redirect https non-www to www
    RewriteCond %{HTTPS} on
    RewriteCond %{HTTP_HOST} ^jtsc.abctraders\.com$
    RewriteRule (.*) https://www.jtsc.abctraders.com/$1 [R=301,L]
    #run from public folder
    RewriteRule ^(.*)$ public/$1 [L,NC]
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php73” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php73___lsphp .php .php7 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
